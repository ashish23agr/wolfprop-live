/**
 * Render properties for a specific tab
 */
function render_properties_for_tab($tab, $filters, $price_range)
{
	$args = build_property_query_args($filters, $tab, $price_range);

	// Debug logging
	error_log("Property Query for tab '$tab': " . print_r($args, true));

	$query = new WP_Query($args);

	error_log("Query Results for tab '$tab': Found {$query->found_posts} posts");

	if ($query->have_posts()) {
		while ($query->have_posts()) {
			$query->the_post();
			render_single_property(get_the_ID());
		}

		// Pagination
		if (function_exists('pagination')) {
			if ($tab === 'all') {
				pagination('all', $filters['paged'], $query->max_num_pages);
			} else {
				pagination('all', 1, $query->max_num_pages);
			}
		}
	} else {
		// Debug: Try a simpler query to see if any properties exist
		$debug_query = new WP_Query([
			'post_type' => ['sale-listing', 'rental-listing'],
			'post_status' => 'publish',
			'posts_per_page' => 5,
		]);

		error_log("Debug Query Results: Found {$debug_query->found_posts} total properties");

		if ($debug_query->have_posts()) {
			echo '<div class="property-listing"><h3 class="no_property">No properties match your current filters, but ' . $debug_query->found_posts . ' properties exist in the database. Try adjusting your filters.</h3></div>';
		} else {
			echo '<div class="property-listing"><h3 class="no_property">No properties found in the database. Please check if properties are properly created.</h3></div>';
		}
		wp_reset_postdata();
	}

	wp_reset_postdata();
}

