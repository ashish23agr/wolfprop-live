/**
 * Optimized Property Query Builder
 * Builds a single, efficient WP_Query for all property filtering scenarios
 */
function build_optimized_property_query($filters)
{
	$args = array(
		'post_status' => 'publish',
		'posts_per_page' => 10,
		'update_post_meta_cache' => true,
		'update_post_term_cache' => true
	);

	// Handle pagination
	if (!empty($filters['paged'])) {
		$args['paged'] = $filters['paged'];
	}

	// Handle sorting
	if ($filters['sortby'] == "recent") {
		$args['orderby'] = 'date';
		$args['order'] = 'DESC';
	} elseif ($filters['sortby'] == "price_asc") {
		$args['meta_key'] = 'listing_price';
		$args['orderby'] = 'meta_value_num';
		$args['order'] = 'ASC';
	} elseif ($filters['sortby'] == "price_desc") {
		$args['meta_key'] = 'listing_price';
		$args['orderby'] = 'meta_value_num';
		$args['order'] = 'DESC';
	}

	// Handle post types based on property type filter
	if ($filters['filter_property_type'] == "buy" || $filters['filter_property_type'] == "sale") {
		$args['post_type'] = 'sale-listing';
	} elseif ($filters['filter_property_type'] == "rent") {
		$args['post_type'] = 'rental-listing';
	} else {
		$args['post_type'] = array('sale-listing', 'rental-listing');
	}

	// Build optimized meta query
	$meta_query = array('relation' => 'AND');

	// Handle sold/available status
	if ($filters['filter_property_type'] == "sold") {
		$meta_query[] = array(
			'key' => 'sold_under_contract',
			'value' => '1',
			'compare' => '='
		);
	} elseif ($filters['filter_property_type'] != "sold") {
		$meta_query[] = array(
			'relation' => 'OR',
			array(
				'key' => 'sold_under_contract',
				'value' => '1',
				'compare' => '!='
			),
			array(
				'key' => 'sold_under_contract',
				'compare' => 'NOT EXISTS'
			)
		);
	}

	// Handle listing end date (only for non-sold properties)
	if ($filters['filter_property_type'] != "sold") {
		$meta_query[] = array(
			'relation' => 'OR',
			array(
				'key' => 'listing_end',
				'value' => date('Y-m-d'),
				'compare' => '>=',
				'type' => 'DATE'
			),
			array(
				'key' => 'listing_end',
				'compare' => 'NOT EXISTS'
			)
		);
	}

	// Handle address filter
	if (!empty($filters['filter_address'])) {
		$post_exit = get_post($filters['filter_address']);
		if (empty($post_exit)) {
			$address_query = array(
				'relation' => 'OR',
				array(
					'key' => 'address',
					'value' => $filters['filter_address'],
					'compare' => 'LIKE'
				),
				array(
					'key' => 'city',
					'value' => $filters['filter_address'],
					'compare' => 'LIKE'
				),
				array(
					'key' => 'zip_code',
					'value' => $filters['filter_address'],
					'compare' => 'LIKE'
				)
			);

			// Check for state matches
			$termargs = array(
				'taxonomy' => 'state',
				'fields' => 'ids',
				'hide_empty' => false,
				'name__like' => $filters['filter_address']
			);
			$state_terms = get_terms($termargs);
			if (!empty($state_terms)) {
				$address_query[] = array(
					'key' => 'state',
					'value' => $state_terms,
					'compare' => 'IN',
					'type' => 'NUMERIC'
				);
			}

			$meta_query[] = $address_query;
		} else {
			$args['post__in'] = array($filters['filter_address']);
		}
	}

	// Handle bedrooms filter
	if (!empty($filters['filter_beds'])) {
		if ($filters['filter_beds'] != "5+") {
			$meta_query[] = array(
				'key' => 'bedrooms',
				'value' => $filters['filter_beds'],
				'compare' => '=',
				'type' => 'NUMERIC'
			);
		} else {
			$meta_query[] = array(
				'key' => 'bedrooms',
				'value' => 5,
				'compare' => '>',
				'type' => 'NUMERIC'
			);
		}
	}

	// Handle bathrooms filter
	if (!empty($filters['filter_baths'])) {
		if ($filters['filter_baths'] != "5+") {
			$meta_query[] = array(
				'key' => 'bathrooms',
				'value' => $filters['filter_baths'],
				'compare' => '=',
				'type' => 'NUMERIC'
			);
		} else {
			$meta_query[] = array(
				'key' => 'bathrooms',
				'value' => 5,
				'compare' => '>',
				'type' => 'NUMERIC'
			);
		}
	}

	// Handle area filters
	if (!empty($filters['building_min_area'])) {
		$meta_query[] = array(
			'key' => 'building_size',
			'value' => $filters['building_min_area'],
			'compare' => '>=',
			'type' => 'NUMERIC'
		);
	}

	if (!empty($filters['building_max_area'])) {
		$meta_query[] = array(
			'key' => 'building_size',
			'value' => $filters['building_max_area'],
			'compare' => '<=',
			'type' => 'NUMERIC'
		);
	}

	// Handle price range filter
	if (!empty($filters['slidemin']) && !empty($filters['slidemax'])) {
		$meta_query[] = array(
			'key' => 'listing_price',
			'value' => array($filters['slidemin'], $filters['slidemax']),
			'compare' => 'BETWEEN',
			'type' => 'NUMERIC'
		);
	}

	// Handle listing status filter
	if (!empty($filters['listing_status'])) {
		$meta_query[] = array(
			'key' => 'listing_status',
			'value' => $filters['listing_status'],
			'compare' => '='
		);
	}

	$args['meta_query'] = $meta_query;

	// Handle taxonomy queries
	$tax_query = array();

	if (!empty($filters['filter_building_type'])) {
		$tax_query[] = array(
			'taxonomy' => 'building-style',
			'field' => 'term_id',
			'terms' => $filters['filter_building_type']
		);
	}

	if (!empty($filters['area'])) {
		$tax_query[] = array(
			'taxonomy' => 'neighbourhood',
			'field' => 'term_id',
			'terms' => array($filters['area'])
		);
	}

	if (!empty($tax_query)) {
		$args['tax_query'] = $tax_query;
	}

	return $args;
}

/**
 * Prefetch Property Data
 * Eliminates N+1 queries by prefetching all related data
 */
function prefetch_property_data($properties)
{
	if (empty($properties))
		return array();

	$property_IDs = wp_list_pluck($properties, 'ID');
	$agent_ids = array();

	// Prefetch all meta data
	update_meta_cache('post', $property_IDs);

	// Collect agent IDs for batch user query
	foreach ($properties as $property) {
		$agent_id = get_post_meta($property->ID, 'agent', true);
		if ($agent_id) {
			$agent_ids[] = $agent_id;
		}
	}

	// Prefetch user data
	$users_data = array();
	if (!empty($agent_ids)) {
		$unique_agent_ids = array_unique($agent_ids);
		foreach ($unique_agent_ids as $agent_id) {
			$users_data[$agent_id] = get_userdata($agent_id);
		}
	}

	return $users_data;
}

/**
 * Render Property Listing
 * Single template for rendering properties in both list and grid views
 */
function render_property_listing($properties, $users_data, $view_type = 'list')
{
	if (empty($properties)) {
		echo '<div class="property-listing"><h3 class="no_property">No Property Found</h3></div>';
		return;
	}

	foreach ($properties as $property) {
		setup_postdata($property);
		global $post;
		$post = $property;

		$property_photos = get_field('property_photos', $property->ID);
		$agent_id = get_post_meta($property->ID, 'agent', true);
		$user_info = isset($users_data[$agent_id]) ? $users_data[$agent_id] : null;
		$building_size = get_field("building_size", $property->ID);
		$price = get_field("listing_price", $property->ID);
		$per_square = ($price && $building_size) ? $price / $building_size : 0;
		$project_status = get_field('sold_under_contract', $property->ID);
		$property_post_type = get_post_type($property->ID);
		$state = get_field("state", $property->ID);

		if ($view_type == 'grid') {
			render_property_grid_item($property, $property_photos, $user_info, $building_size, $price, $per_square, $project_status, $property_post_type, $state);
		} else {
			render_property_list_item($property, $property_photos, $user_info, $building_size, $price, $per_square, $project_status, $property_post_type, $state);
		}
	}

	wp_reset_postdata();
}

