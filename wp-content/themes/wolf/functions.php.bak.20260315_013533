	];
}

/**
 * Parse price range from filter_price string
 */
function parse_price_range($filter_price)
{
	if (empty($filter_price)) {
		return ['min' => '', 'max' => ''];
	}

	$filter_price = str_replace('$', '', $filter_price);
	$price_parts = explode('-', $filter_price);

	return [
		'min' => trim($price_parts[0] ?? ''),
		'max' => trim($price_parts[1] ?? '')
	];
}

/**
 * Build WP_Query arguments based on filters and tab
 */
function build_property_query_args($filters, $tab, $price_range)
{
	$args = [
		'post_status' => 'publish',
		'posts_per_page' => 10,
		'paged' => $filters['paged'],
	];

	// Set post types based on tab
	switch ($tab) {
		case 'sale':
			$args['post_type'] = 'sale-listing';
			break;
		case 'rent':
			$args['post_type'] = 'rental-listing';
			break;
		case 'sold':
			$args['post_type'] = ['sale-listing', 'rental-listing'];
			break;
		default:
			$args['post_type'] = ['sale-listing', 'rental-listing'];
	}

	// Add sorting
	switch ($filters['sortby']) {
		case 'recent':
			$args['orderby'] = 'date';
			$args['order'] = 'DESC';
			break;
		case 'price_asc':
			$args['meta_key'] = 'listing_price';
			$args['orderby'] = 'meta_value_num';
			$args['order'] = 'ASC';
			break;
		case 'price_desc':
			$args['meta_key'] = 'listing_price';
			$args['orderby'] = 'meta_value_num';
			$args['order'] = 'DESC';
			break;
	}

	// Build meta query
	$meta_query = ['relation' => 'AND'];

	// Handle sold status
	if ($tab === 'sold') {
		$meta_query[] = [
			'key' => 'sold_under_contract',
			'value' => '1',
			'compare' => '='
		];
	} else {
		$meta_query[] = [
			'relation' => 'OR',
			[
				'key' => 'sold_under_contract',
				'value' => '1',
				'compare' => '!='
			],
			[
				'key' => 'sold_under_contract',
				'compare' => 'NOT EXISTS'
			]
		];
	}

	// Add other filters
	if (!empty($filters['filter_beds'])) {
		if ($filters['filter_beds'] === '5+') {
			$meta_query[] = [
				'key' => 'bedrooms',
				'value' => 5,
				'compare' => '>',
				'type' => 'NUMERIC'
			];
		} else {
			$meta_query[] = [
				'key' => 'bedrooms',
				'value' => $filters['filter_beds'],
				'compare' => '=',
				'type' => 'NUMERIC'
			];
		}
	}

	if (!empty($filters['filter_baths'])) {
		if ($filters['filter_baths'] === '5+') {
			$meta_query[] = [
				'key' => 'bathrooms',
				'value' => 5,
				'compare' => '>',
				'type' => 'NUMERIC'
			];
		} else {
			$meta_query[] = [
				'key' => 'bathrooms',
				'value' => $filters['filter_baths'],
				'compare' => '=',
				'type' => 'NUMERIC'
			];
		}
	}

	// Price range
	if (!empty($price_range['min']) && !empty($price_range['max'])) {
		$meta_query[] = [
			'key' => 'listing_price',
			'value' => [$price_range['min'], $price_range['max']],
			'compare' => 'BETWEEN',
			'type' => 'NUMERIC'
		];
	}

	// Building area
	if (!empty($filters['building_min_area'])) {
		$meta_query[] = [
			'key' => 'building_size',
			'value' => $filters['building_min_area'],
			'compare' => '>=',
			'type' => 'NUMERIC'
		];
	}

	if (!empty($filters['building_max_area'])) {
		$meta_query[] = [
			'key' => 'building_size',
			'value' => $filters['building_max_area'],
			'compare' => '<=',
			'type' => 'NUMERIC'
		];
	}

	if (count($meta_query) > 1) {
		$args['meta_query'] = $meta_query;
	}

	// Build tax query
	$tax_query = [];

	if (!empty($filters['filter_building_type'])) {
		$tax_query[] = [
			'taxonomy' => 'building-style',
			'field' => 'term_id',
			'terms' => $filters['filter_building_type']
		];
	}

	if (!empty($filters['area'])) {
		$tax_query[] = [
			'taxonomy' => 'neighbourhood',
			'field' => 'term_id',
			'terms' => [$filters['area']]
		];
	}

	if (!empty($tax_query)) {
		$args['tax_query'] = $tax_query;
	}

	return $args;
}

