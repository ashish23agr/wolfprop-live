jQuery(function($) {
    var currentTab = 'all';
    var currentType = '';

    ajaxSubmit();

    function ajaxSubmit(extra='', callback=false) {
        var sortby = $("#sortby").val() || 'recent';
        var filterform;

        if (propertyAjax.has_action === 'true') {
            filterform = $('#property_filter').serialize();
        } else {
            filterform = 'action=filter_properties';
        }

        filterform += '&sortby=' + sortby;
        filterform += '&tab=' + currentTab;
        if (currentType !== '') {
            filterform += '&filter_property_type=' + currentType;
        }
        filterform += extra;

        $.ajax({
            type: "get",
            url: propertyAjax.ajaxurl,
            data: filterform,
            success: function(data) {
                $('.property_listing').html(data);
                if (callback == true) {
                    $('html, body').animate({
                        scrollTop: $(".property_listing").offset().top
                    }, 800);
                    $(".loading").css("display", "none");
                }
            },
            error: function(xhr, status, error) {
                $('.property_listing').html('<div class="error">Error loading properties. Please try again.</div>');
            }
        });
    }

    $("#sortby").change(function() {
        $(".property_listing").html('<img style="display:block;margin:0 auto;" alt="loading" src="' + propertyAjax.template_uri + '/images/ring.gif">');
        ajaxSubmit();
    });

    $('body').on('click', '[data-toggle="tab"], .filter_property_type, a[href*="filter_property_type"]', function(e) {
        e.preventDefault();
        var href = $(this).attr('href') || '';
        var dataType = $(this).attr('data-type') || '';

        if (dataType !== '') {
            currentType = dataType;
            currentTab = dataType === 'sold' ? 'sold' : dataType;
        } else if (href.indexOf('forsale') > -1 || href === '#forsale') {
            currentTab = 'sale'; currentType = 'sale';
        } else if (href.indexOf('forrent') > -1 || href === '#forrent') {
            currentTab = 'rent'; currentType = 'rent';
        } else if (href.indexOf('sold') > -1) {
            currentTab = 'sold'; currentType = 'sold';
        } else {
            currentTab = 'all'; currentType = '';
        }

        $(".loading").css("display", "block");
        ajaxSubmit('', true);
    });

    $('body').on('click', 'a.inactive', function(e) {
        e.preventDefault();
        var paged = $(this).attr("data-paged");
        var tab   = $(this).attr("data-tab");

        if (tab && tab !== '') {
            currentTab = tab;
        }

        $(".loading").css("display", "block");
        ajaxSubmit('&paged=' + paged, true);
    });
});
