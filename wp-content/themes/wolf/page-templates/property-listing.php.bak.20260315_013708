<div class="loading">Loading&#8230;</div>

<script>
jQuery(function($) {
    var currentTab = 'all';
    var currentType = '';

    ajaxSubmit();

    function ajaxSubmit(extra, callback) {
        extra = extra || '';
        callback = callback || false;

        var sortby = $("#sortby").val() || 'recent';
        var filterform = 'action=filter_properties';
        filterform += '&sortby=' + sortby;
        filterform += '&tab=' + currentTab;
        if (currentType !== '') {
            filterform += '&filter_property_type=' + currentType;
        }
        filterform += extra;

        var ajaxurl = '<?php echo admin_url('admin-ajax.php'); ?>';

        $.ajax({
            type: "get",
            url: ajaxurl,
            data: filterform,
            success: function(data) {
                $('.property_listing').html(data);
                if (callback === true) {
                    $('html, body').animate({
                        scrollTop: $(".property_listing").offset().top
                    }, 800);
                    $(".loading").css("display", "none");
                }
            },
            error: function() {
                $('.property_listing').html('<p>Error loading properties. Please refresh the page.</p>');
            }
        });
    }

    // Sort change
    $("#sortby").change(function() {
        $(".property_listing").html('<img style="display:block;margin:0 auto;" alt="loading" src="<?php echo get_template_directory_uri(); ?>/images/ring.gif">');
        ajaxSubmit();
    });

    // Tab clicks (All / For Sale / For Rent / Sold)
    $('body').on('click', 'a[data-toggle="tab"]', function(e) {
        e.preventDefault();
        e.stopImmediatePropagation();

        var href = $(this).attr('href') || '';

        if (href === '#forsale' || href === '#forsalegrid') {
            currentTab = 'sale'; currentType = 'sale';
        } else if (href === '#forrent' || href === '#forrentgrid') {
            currentTab = 'rent'; currentType = 'rent';
        } else if (href === '#forsold' || href === '#forsoldgrid') {
            currentTab = 'sold'; currentType = 'sold';
        } else {
            currentTab = 'all'; currentType = '';
        }

        $(this).closest('ul').find('li').removeClass('active');
        $(this).closest('li').addClass('active');

        $(".loading").css("display", "block");
        $(".property_listing").html('<img style="display:block;margin:0 auto;" alt="loading" src="<?php echo get_template_directory_uri(); ?>/images/ring.gif">');
        ajaxSubmit('', true);
    });

    // Sidebar Property Status filter clicks
    $('body').on('click', 'a.filter_property_type', function(e) {
        e.preventDefault();
        e.stopImmediatePropagation();

        var dataType = $(this).attr('data-type') || '';
        if (dataType === 'rent') {
            currentTab = 'rent'; currentType = 'rent';
        } else if (dataType === 'sale') {
            currentTab = 'sale'; currentType = 'sale';
        } else if (dataType === 'sold') {
            currentTab = 'sold'; currentType = 'sold';
        } else {
            currentTab = 'all'; currentType = '';
        }

        $(".loading").css("display", "block");
        $(".property_listing").html('<img style="display:block;margin:0 auto;" alt="loading" src="<?php echo get_template_directory_uri(); ?>/images/ring.gif">');
        ajaxSubmit('', true);
    });

    // Pagination clicks
    $('body').on('click', 'a.inactive', function(e) {
        e.preventDefault();
        e.stopImmediatePropagation();

        var paged = $(this).attr("data-paged");
        var tab = $(this).attr("data-tab");
        if (tab && tab !== '') {
            currentTab = tab;
        }

        $(".loading").css("display", "block");
        ajaxSubmit('&paged=' + paged, true);
    });
});
</script>

